[Unit]
Description=Witness forensic activity monitor
Documentation=https://github.com/shafikshaon/witness
# Start as early as practical. DefaultDependencies=no lets us order before the network and
# login services; the matching Conflicts/Before=shutdown.target makes us stop *after* them.
DefaultDependencies=no
RequiresMountsFor=/var/lib/witness
After=local-fs.target systemd-journald.socket
Requires=local-fs.target
# Services that must not start unobserved: network, SSH, and any user session.
Wants=network-pre.target
Before=network-pre.target sshd.service ssh.service systemd-user-sessions.service
Before=shutdown.target
Conflicts=shutdown.target
StartLimitIntervalSec=60
StartLimitBurst=20

[Service]
# READY=1 is sent only after the eBPF programs are attached, so everything ordered after
# us starts under capture.
Type=notify
NotifyAccess=main
ExecStart=/usr/sbin/witnessd run --config /etc/witness/config.toml
Restart=always
RestartSec=1
# The main loop pings only while the pipeline is healthy; a stall gets us restarted.
WatchdogSec=30
TimeoutStartSec=60
# A stop during a slow startup waits for in-flight kernel verifier jobs (seconds, tens of
# seconds on a saturated CPU); 60 s avoids SIGKILLing a daemon that is stopping cleanly.
TimeoutStopSec=60
OOMScoreAdjust=-900
LimitMEMLOCK=infinity
MemoryHigh=384M
MemoryMax=768M
CPUWeight=200
IOWeight=200

# --- Hardening (each choice is explained in docs/DESIGN.md §6.3) ---------------------------
User=root
# Measured, not guessed (DESIGN.md §6.3): capture works with just CAP_BPF + CAP_PERFMON.
# CAP_SYS_PTRACE reads other users' /proc/<pid>/exe and cwd; CAP_DAC_READ_SEARCH is for
# hashing files. CAP_SYS_ADMIN / CAP_NET_ADMIN / CAP_AUDIT_READ are deliberately absent until
# a feature that needs them lands and is tested. CAP_CHOWN is only for giving the API socket
# to the `witness` group.
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_CHOWN
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
# /etc/witness/rules.d is writable so the API can save rules (tier 2 callers only).
ReadWritePaths=/var/lib/witness /run/witness /etc/witness/rules.d
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RuntimeDirectory=witness
RuntimeDirectoryMode=0750
StateDirectory=witness
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
